# CN0566 / Pluto single-carrier QPSK public-release defaults.
# Begin conservatively. The previously measured direct-path experiment used
# TX_GAIN=-40 dB, but that value is not safe for every geometry.
PHASER_URI="ip:localhost"
SDR_URI="ip:192.168.2.1"
CAL_DIR="calibration"
WAV="sample.wav"
TX_OUTPUT="2"
TX_GAIN="-60"
RX_GAIN="20"
ARRAY_GAIN="127"
BEAM_PHASE_DIFF="0.0"
DECODE_CHANNEL="rx2"
CORRELATION_THRESHOLD="0.18"
AUDIO_DEVICE="default"
AUDIO_BUFFER_MS="1500"
LOG_LEVEL="INFO"
