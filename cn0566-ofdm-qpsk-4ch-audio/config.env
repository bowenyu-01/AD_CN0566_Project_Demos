# CN0566 / Pluto fixed hardware profile
PHASER_URI="ip:localhost"
SDR_URI="ip:192.168.2.1"
CAL_DIR="calibration"

# Four input files. Replace the bundled test tones with your own WAV files.
WAV1="sample_1.wav"
WAV2="sample_2.wav"
WAV3="sample_3.wav"
WAV4="sample_4.wav"

# OFDM profile. Start with stable_1m. The 1.5 and 2 MSPS profiles are
# benchmarks only after the stable profile passes the realtime benchmark and
# a long no-play hardware run with zero host drops and zero TX starvation.
OFDM_PROFILE="stable_1m"

# RF settings. OFDM has higher PAPR than the previous single-carrier QPSK link.
# Public-release default is conservative. Raise TX level only after the RF sanity test.
TX_GAIN="-60"
RX_GAIN="20"
ARRAY_GAIN="127"
BEAM_PHASE_DIFF="0.0"
TX_DIGITAL_RMS="2000"
TX_DIGITAL_PEAK="6000"
CORRELATION_THRESHOLD="0.20"

# RX2 is the stable real-time mode. MRC adds a second USB receive stream.
DECODE_MODE="rx2"

# selected: transmit all four streams but decode only currently audible channels.
# all: decode all four streams continuously for validation/performance testing.
DECODE_SCOPE="selected"

# Raspberry Pi realtime controls. Four native FEC workers use the four Pi 4
# cores. BER/EVM are refreshed every fifth valid frame in normal live mode;
# performance capture still evaluates every frame. ALSA receives 200 ms blocks.
CHANNEL_DECODE_WORKERS="2"
METRICS_INTERVAL="25"
AUDIO_WRITE_FRAMES="10"

# Playback. LISTEN can be 1, 2, 3, 4, 1,3, all, or none.
LISTEN="1"
AUDIO_BUFFER_MS="2000"
AUDIO_DEVICE="default"
RECORD_DIR=""

# Test durations
OFDM_TEST_SECONDS="30"
PERFORMANCE_SECONDS="30"
LOG_LEVEL="INFO"
